<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion | Athéna Dentaire</title>
    <link rel="stylesheet" href="{{ asset('styles/app.built.css') }}">
</head>
<body class="flex min-h-screen items-center justify-center bg-brand-gray">
<div class="w-full max-w-md rounded-2xl bg-white p-8 shadow-lg">
    <h1 class="mb-6 text-center text-2xl font-bold text-brand-blue">Administration</h1>
    {% if error %}
        <div class="mb-4 rounded-lg bg-red-100 px-4 py-3 text-sm text-red-800">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}
    <form method="post" class="admin-form space-y-4">
        <div>
            <label for="username">Email</label>
            <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>
        </div>
        <div>
            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="_password" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="btn-primary w-full">Se connecter</button>
    </form>
</div>
</body>
</html>
