{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}
{% block admin_title %}Tableau de bord{% endblock %}

{% block admin_body %}
{% set stats = [
    { key: 'messages', label: 'Messages reçus', value: messagesCount, route: 'admin_message_index', admin: false },
    { key: 'sections', label: 'Sections éditables', value: sectionsCount, route: 'admin_section_index', admin: true },
    { key: 'services', label: 'Services', value: servicesCount, route: 'admin_service_index', admin: true },
    { key: 'facilities', label: 'Plateau technique', value: facilitiesCount, route: 'admin_facility_index', admin: true },
    { key: 'team', label: 'Membres équipe', value: teamCount, route: 'admin_team_index', admin: true },
    { key: 'hours', label: 'Horaires', value: hoursCount, route: 'admin_opening_hour_index', admin: true },
] %}
<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {% for stat in stats %}
        {% set linked = not stat.admin or is_granted('ROLE_ADMIN') %}
        {% if linked %}<a href="{{ path(stat.route) }}" class="block rounded-xl bg-white p-6 shadow hover:shadow-md">{% else %}<div class="rounded-xl bg-white p-6 shadow">{% endif %}
            <p class="text-sm text-gray-500">{{ stat.label }}</p>
            <p class="text-3xl font-bold text-brand-blue" data-stat="{{ stat.key }}">{{ stat.value }}</p>
        {% if linked %}</a>{% else %}</div>{% endif %}
    {% endfor %}
</div>

{% if latestMessages is not empty %}
<section class="mt-8">
    <h2 class="mb-4 text-lg font-semibold">Derniers messages</h2>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Nom</th>
                <th>Sujet</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for message in latestMessages %}
            <tr>
                <td>{{ message.createdAt|date('d/m/Y H:i') }}</td>
                <td>{{ message.fullName }}</td>
                <td>{{ message.subject }}</td>
                <td><a href="{{ path('admin_message_show', {id: message.id}) }}" class="text-brand-cyan">Voir</a></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
{% endif %}
{% endblock %}
