{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}
{% block admin_title %}Tableau de bord{% endblock %}

{% block admin_body %}
<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <div class="rounded-xl bg-white p-6 shadow">
        <p class="text-sm text-gray-500">Messages reçus</p>
        <p class="text-3xl font-bold text-brand-blue">{{ latestMessages|length }}</p>
    </div>
    <div class="rounded-xl bg-white p-6 shadow">
        <p class="text-sm text-gray-500">Sections éditables</p>
        <p class="text-3xl font-bold text-brand-blue">{{ sectionsCount }}</p>
    </div>
    <div class="rounded-xl bg-white p-6 shadow">
        <p class="text-sm text-gray-500">Membres équipe</p>
        <p class="text-3xl font-bold text-brand-blue">{{ teamCount }}</p>
    </div>
</div>

{% if latestMessages is not empty %}
<section class="mt-8">
    <h2 class="mb-4 text-lg font-semibold">Derniers messages</h2>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Nom</th>
                <th>Sujet</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for message in latestMessages %}
            <tr>
                <td>{{ message.createdAt|date('d/m/Y H:i') }}</td>
                <td>{{ message.fullName }}</td>
                <td>{{ message.subject }}</td>
                <td><a href="{{ path('admin_message_show', {id: message.id}) }}" class="text-brand-cyan">Voir</a></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
{% endif %}
{% endblock %}
