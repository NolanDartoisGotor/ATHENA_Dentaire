{% extends 'admin/base.html.twig' %}
{% block title %}Message{% endblock %}
{% block admin_title %}Message de {{ message.fullName }}{% endblock %}
{% block admin_body %}
<div class="max-w-2xl rounded-xl bg-white p-6 shadow">
    <p class="text-sm text-gray-500">Reçu le {{ message.createdAt|date('d/m/Y à H:i') }}</p>
    <dl class="mt-4 space-y-3">
        <div><dt class="font-semibold">Nom</dt><dd>{{ message.lastName }}</dd></div>
        <div><dt class="font-semibold">Prénom</dt><dd>{{ message.firstName }}</dd></div>
        <div><dt class="font-semibold">Email</dt><dd><a href="mailto:{{ message.email }}">{{ message.email }}</a></dd></div>
        <div><dt class="font-semibold">Sujet</dt><dd>{{ message.subject }}</dd></div>
        <div><dt class="font-semibold">Message</dt><dd class="whitespace-pre-wrap">{{ message.message }}</dd></div>
    </dl>
    <a href="{{ path('admin_message_index') }}" class="mt-6 inline-block text-brand-cyan">← Retour</a>
</div>
{% endblock %}
