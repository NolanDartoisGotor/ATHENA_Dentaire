{% extends 'admin/base.html.twig' %}
{% block title %}Utilisateurs{% endblock %}
{% block admin_title %}Utilisateurs{% endblock %}
{% block admin_body %}
<p class="mb-4"><a href="{{ path('admin_user_new') }}" class="btn-primary">Ajouter un utilisateur</a></p>
<table class="admin-table">
    <thead><tr><th>Email</th><th>Nom</th><th>Rôles</th><th>2FA</th><th></th></tr></thead>
    <tbody>
        {% for user in users %}
        <tr>
            <td>{{ user.email }}</td>
            <td>{{ user.fullName }}</td>
            <td>{{ user.roles|join(', ') }}</td>
            <td>{{ user.emailAuthEnabled ? 'Activée' : 'Désactivée' }}</td>
            <td class="space-x-2">
                <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="text-brand-cyan">Modifier</a>
                <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}" class="inline" onsubmit="return confirm('Supprimer ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                    <button type="submit" class="text-red-600">Supprimer</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
