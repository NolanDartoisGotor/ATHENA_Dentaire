{% extends 'base.html.twig' %}

{% block title %}{{ section.title }} | {{ settings.organizationName }}{% endblock %}

{% block body %}
<header class="border-b border-gray-200 bg-white">
    <div class="page-shell flex h-[72px] items-center justify-between px-5 md:h-20 md:px-20">
        <a href="{{ path('home') }}" class="flex items-center gap-2.5 md:gap-3">
            <img src="{{ asset('images/logo.svg') }}" alt="" class="h-6 w-6 md:h-7 md:w-7" width="28" height="28">
            <span class="font-[family-name:var(--font-literata)] text-lg font-extrabold text-brand-blue md:text-[22px]">Athéna Dentaire</span>
        </a>
        <a href="{{ path('home') }}" class="text-[15px] font-medium text-[#1a1a1a] hover:text-brand-cyan">Retour au site</a>
    </div>
</header>

<main class="flex-1 bg-white">
    <article class="page-shell px-5 py-10 md:px-20 md:py-16">
        <header class="mb-8 space-y-2">
            <h1 class="font-[family-name:var(--font-montserrat)] text-[32px] font-bold leading-tight text-brand-blue md:text-[40px]">
                {{ section.title }}
            </h1>
            {% if section.subtitle %}
                <p class="text-base text-[#4b5563]">{{ section.subtitle }}</p>
            {% endif %}
        </header>
        <div class="legal-content max-w-3xl space-y-4 text-base leading-[26px] text-[#4b5563] [&_a]:text-brand-cyan [&_a]:underline [&_h2]:mt-8 [&_h2]:font-[family-name:var(--font-montserrat)] [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-brand-blue [&_li]:ml-5 [&_li]:list-disc [&_p]:mb-4 [&_strong]:font-semibold [&_strong]:text-[#1a1a1a] [&_ul]:mb-4 [&_ul]:space-y-2">
            {{ section.body|sanitize_html('app.legal_sanitizer') }}
        </div>
    </article>

</main>
{% include 'partials/site_footer.html.twig' %}
{% endblock %}
